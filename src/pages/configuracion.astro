---
import { EnvironmentConfig } from "../components/dbvisualizer/features/EnvironmentConfig";
import AppLayout from "../components/dbvisualizer/ui/appLayout.astro";

---

<AppLayout>
<div class="max-w-5xl mx-auto">
    <header class="mb-6">
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
        Configuración de entornos
      </h1>
      <p class="text-sm text-slate-500 mt-1">
        Elige el origen y el destino. El linked server se resuelve automáticamente según el destino.
      </p>
    </header>

    <EnvironmentConfig client:load />
  </div>

</AppLayout>


