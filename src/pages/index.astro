---
import Layout from "../layout/Layout.astro";
import Container from "../components/container.astro";
import Header from "../components/Header.astro";
import Loader from "../components/Loader.astro";
import Cards from "../components/cards.astro";

type Tool = {
	id: string;
	icon: string;
	label: string;
	status: string;
	text: string;
	platform: string;
	functionDescription: string[];
	labelButton: string;
	href: string;
	theme: "blue" | "indigo" | "amber" | "slate";
	enabled: boolean;
	type?: "roadmap";
};

const tools: Tool[] = [
	{
		id: "email-creator",
		icon: "code_xml",
		label: "Email Creator",
		status: "Estable · v2.1",
		text: "Diseñador visual y generador de plantillas HTML responsivas para correos con soporte de comodines dinámicos.",
		platform: "Unlayer",
		functionDescription: ["Outlook & Gmail Safe", "Exportación HTML pura"],
		labelButton: "Abrir Editor",
		href: "/email-creator",
		theme: "blue",
		enabled: true,
	},
	{
		id: "email-test",
		icon: "outgoing_mail",
		label: "Email Test",
		status: "Gateway Activo",
		text: "Despacho inmediato de correos de prueba, validación de variables en tiempo real y previsualización de payload JSON.",
		platform: "Sandbox",
		functionDescription: ["API Mocking OK", "Variables por Lotes"],
		labelButton: "Lanzar Prueba",
		href: "/email-test",
		theme: "indigo",
		enabled: true,
	},
	{
		id: "db-promote",
		icon: "host",
		label: "DB Promote",
		status: "DevOps & DBA",
		text: "Comparación y sincronización de configuraciones y registros entre ambientes TEST_STAGING y PROD_PRIMARY.",
		platform: "Sync Tool",
		functionDescription: ["Diff visual SQL", "Auditoría Segura"],
		labelButton: "Acceder a DB Promote",
		href: "/db-compare",
		theme: "amber",
		enabled: true,
	},
	{
		id: "roadmap",
		icon: "html",
		label: "Próximas Herramientas",
		status: "En Incubación",
		text: "Propone mas herramientas que nos permitan agilizar nuestro flujo de trabajo",
		platform: "",
		functionDescription: [
			
		],
		labelButton: "+ Proponer una utilidad",
		href: "#propose-tool",
		theme: "slate",
		enabled: true,
		type: "roadmap",
	},
];
---

<style>
	.preloader {
		width: 100%;
		height: 100%;
		position: fixed;
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: 2222;
		top: 0;
		bottom: 0;
		background-color: #faf2e3 !important;
	}
</style>

<div class="preloader">
	<Loader />
</div>
<Layout title="Tools">
	<Header />

	<Container>
		<section aria-labelledby="tools-grid-heading" data-purpose="tools-collection">
			<h2 class="sr-only" id="tools-grid-heading">
				Módulos de Herramientas
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{tools
					// .filter((tool) => tool.type !== "roadmap")
					.map((tool) => (
						<Cards {...tool} />
					))}
			</div>
		</section>
	</Container>
</Layout>


<script is:inline>
	window.onload = function () {
		setTimeout(function () {
			document.querySelector(".preloader").style.display = "none";
		}, 2000);
	};
</script>
