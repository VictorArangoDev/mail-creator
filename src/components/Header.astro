---
---

<header
  class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80"
  data-purpose="global-header"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand & Platform Version Tag -->
    <div class="flex items-center gap-3 shrink-0">
      <a
        aria-label="Cadena Tools Home"
        class="flex items-baseline group"
        href="/"
      >
        <img class="h-6" src="./logo.png" alt="" />
      </a>
      <div class="h-4 w-px bg-slate-200 hidden sm:block"></div>
      <div class="flex items-center gap-1.5 hidden sm:flex">
        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
          INTERNAL PLATFORM v2.4
        </span>
      </div>
    </div>

    <div class="flex-1 max-w-md hidden md:block">
    </div>
    <!-- Status Indicator & User Navigation -->
    <div class="flex items-center gap-4 shrink-0">
      <!-- Live Status Badge -->
      <div class="flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-emerald-700 text-xs font-medium">
        <span class="relative flex h-2 w-2">
          <span class="badge-dot-pulse absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="hidden sm:inline">Servicios Operativos</span>
        <span class="font-bold sm:hidden">OK</span>
      </div>
      <div class="h-4 w-px bg-slate-200"></div>
      <!-- Documentation Link -->
      <a
        class="text-xs font-medium text-slate-600 hover:text-blue-600 transition-colors hidden lg:flex items-center gap-1"
        href="#docs"
      >
        <svg
          class="w-4 h-4 text-slate-400"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        Docs
      </a>
      <!-- User Profile Pill -->
      <div class="flex items-center gap-2 pl-1">
        <div class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center ring-2 ring-blue-100 shadow-sm">
          CD
        </div>
        <span class="text-xs font-semibold text-slate-700 hidden md:block">
          Dev Cadena
        </span>
      </div>
    </div>
  </div>
</header>
