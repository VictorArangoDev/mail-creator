---
import { ConnectionStatus } from "./ConnectionStatus";

// src/presentation/components/layout/Sidebar.astro
const navItems = [
  { label: 'Inicio', icon: 'home', href: '/', active: true },
  { label: 'Tablas permitidas', icon: 'table_chart', href: '#', active: false },
  { label: 'Configuración', icon: 'settings', href: '#', active: false },
];

const version = 'v1.0.0';
---
<aside class="w-64 shrink-0 bg-slate-950 text-slate-200 flex flex-col h-screen sticky top-0 border-r border-slate-800">
  <!-- Logo -->
  <div class="px-5 py-5 border-b border-slate-800">
    <a href="/" class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-lg bg-blue-600 flex items-center justify-center shadow-lg shadow-blue-600/30">
        <span class="material-symbols-outlined text-white text-[20px]">database</span>
      </div>
      <div class="flex flex-col leading-tight">
        <span class="text-sm font-bold text-white">DB</span>
        <span class="text-sm font-bold text-white">Promote</span>
      </div>
    </a>
  </div>

  <!-- Nav -->
  <nav class="flex-1 px-3 py-4 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          'flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors',
          item.active
            ? 'bg-blue-600 text-white shadow-sm shadow-blue-600/40'
            : 'text-slate-400 hover:text-white hover:bg-slate-800/60',
        ]}
      >
        <span class="material-symbols-outlined text-[20px]">{item.icon}</span>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <!-- Status indicators (isla React) -->
  <div class="border-t border-slate-800 p-4 space-y-2">
    <div>
        <ConnectionStatus client:load />
    </div>
  </div>

  <!-- Footer -->
  <div class="border-t border-slate-800 px-4 py-3">
    <div class="text-[11px] text-slate-500 flex items-center gap-1.5">
      <span class="material-symbols-outlined text-[13px]">info</span>
      <span>DB Promote {version}</span>
    </div>
    <div class="text-[11px] text-slate-600 mt-0.5">Ambiente de Uso Interno</div>
  </div>
</aside>