---

import { ConnectionStatus } from "./ConnectionStatus";
---
<header style="border-bottom:1px solid #DDE4E8;background:#FFFFFF">
<div style="max-width:1320px;margin:0 auto;padding:0 32px;box-sizing:border-box;display:flex;align-items:center;gap:8px 32px;flex-wrap:wrap;min-height:68px">

<div style="display:flex;align-items:center;gap:12px">
<svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="11" cy="15" r="9" fill="#2BC4D9"></circle><circle cx="19" cy="15" r="9" fill="#FF9447" style="mix-blend-mode:multiply"></circle></svg>
<span style="font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.02em">DB Promote</span>
</div>

<nav aria-label="Principal" style="display:flex;align-items:stretch;gap:4px;align-self:stretch">
<a class="tab" href="#" aria-current="page" style="display:flex;align-items:center;padding:0 14px;min-height:44px;color:#0F1A1F;font-weight:600;border-bottom:2px solid #0F1A1F;margin-bottom:-1px">Inicio</a>
<a class="tab" href="#" style="display:flex;align-items:center;padding:0 14px;min-height:44px;color:#51626B;font-weight:500">Tablas permitidas</a>
<a class="tab" href="#" style="display:flex;align-items:center;padding:0 14px;min-height:44px;color:#51626B;font-weight:500">Configuración</a>
</nav>

<div style="margin-left:auto;display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:8px 0">

<ConnectionStatus client:load></ConnectionStatus>

<button class="ghost" type="button" aria-label="Ayuda" style="width:44px;height:44px;border:0;border-radius:10px;background:transparent;color:#51626B;display:flex;align-items:center;justify-content:center;cursor:pointer">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7"></path><path d="M12 17h.01"></path></svg>
</button>
<button class="ghost" type="button" style="display:flex;align-items:center;gap:10px;min-height:44px;padding:0 10px 0 6px;border:0;border-radius:99px;background:transparent;color:#0F1A1F;font-size:14px;font-weight:500;cursor:pointer">
<span style="width:32px;height:32px;border-radius:50%;background:#0F1A1F;color:#FFFFFF;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center">AV</span>admin
</button>
</div>
</div>
</header>
