---



import Layout from '../../../layout/Layout.astro';
import TopBar from '../ui/topBar.astro';

interface Props {
  title?: string;
  breadcrumb?: string;
}
const { title = 'DB Promote' } = Astro.props;
---

<Layout title={title}>
  <div class="flex min-h-screen">
    <!-- <Sidebar/> -->

    <div class="flex-1 flex flex-col min-w-0">
      <!-- Top Bar -->
      <TopBar></TopBar>

      <!-- Main content -->
      <main class="flex-1 px-6 py-6">
        <slot />
      </main>
    </div>
  </div>

  
</Layout>
