+++ b/sql/001_create_email_templates.sql
@@ -0,0 +1,18 @@
+-- Tabla para guardar plantillas del email builder.
+-- DesignJson = fuente de verdad (para volver a editar). Html = derivado del diseño.
+-- Cada guardado crea una versión nueva por Name; nunca se sobrescribe.
+
+IF OBJECT_ID('dbo.EmailTemplates', 'U') IS NULL
+BEGIN
+    CREATE TABLE dbo.EmailTemplates (
+        Id         INT IDENTITY(1,1) NOT NULL CONSTRAINT PK_EmailTemplates PRIMARY KEY,
+        Name       NVARCHAR(200)     NOT NULL,
+        Version    INT               NOT NULL,
+        DesignJson NVARCHAR(MAX)     NOT NULL,
+        Html       NVARCHAR(MAX)     NOT NULL,
+        CreatedAt  DATETIME2(0)      NOT NULL CONSTRAINT DF_EmailTemplates_CreatedAt DEFAULT SYSUTCDATETIME(),
+        CONSTRAINT UQ_EmailTemplates_Name_Version UNIQUE (Name, Version),
+        CONSTRAINT CK_EmailTemplates_DesignJson CHECK (ISJSON(DesignJson) = 1)
+    );
+END
+GO
