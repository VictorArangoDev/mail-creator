+import { describe, expect, it } from 'vitest';
+import { SaveTemplateUseCase } from './SaveTemplateUseCase';
+import { TemplateValidationError } from '../domain/errors';
+import type { ITemplateRepository } from '../domain/ports/ITemplateRepository';
+import type { NewTemplate, TemplateSummary } from '../domain/entities/Template';
+
+class InMemoryRepository implements ITemplateRepository {
+  saved: NewTemplate[] = [];
+
+  async save(template: NewTemplate): Promise<TemplateSummary> {
+    this.saved.push(template);
+    const version = this.saved.filter((t) => t.name === template.name).length;
+    return { id: this.saved.length, name: template.name, version, createdAt: new Date().toISOString() };
+  }
+  async getById() {
+    return null;
+  }
+  async list() {
+    return [];
+  }
+}
+
+const validInput = {
+  name: '  Bienvenida  ',
+  design: { body: { rows: [] } },
+  html: '<html><body>Hola</body></html>',
+};
+
+describe('SaveTemplateUseCase', () => {
+  it('guarda diseño y HTML con el nombre sin espacios sobrantes', async () => {
+    const repo = new InMemoryRepository();
+    const result = await new SaveTemplateUseCase(repo).execute(validInput);
+
+    expect(result.name).toBe('Bienvenida');
+    expect(repo.saved[0].design).toEqual(validInput.design);
+    expect(repo.saved[0].html).toBe(validInput.html);
+  });
+
+  it('crea una versión nueva al guardar el mismo nombre otra vez', async () => {
+    const useCase = new SaveTemplateUseCase(new InMemoryRepository());
+    await useCase.execute(validInput);
+    const second = await useCase.execute(validInput);
+
+    expect(second.version).toBe(2);
+  });
+
+  it.each([
+    ['nombre vacío', { ...validInput, name: '   ' }],
+    ['nombre muy largo', { ...validInput, name: 'x'.repeat(201) }],
+    ['diseño sin body', { ...validInput, design: { foo: 1 } }],
+    ['diseño que no es objeto', { ...validInput, design: 'texto' }],
+    ['HTML vacío', { ...validInput, html: '  ' }],
+    ['HTML que no es texto', { ...validInput, html: 123 }],
+  ])('rechaza %s', async (_label, input) => {
+    const repo = new InMemoryRepository();
+    await expect(new SaveTemplateUseCase(repo).execute(input)).rejects.toBeInstanceOf(
+      TemplateValidationError,
+    );
+    expect(repo.saved).toHaveLength(0);
+  });
+});
diff --git a/src/modules/email-builder/use-cases/SaveTemplateUseCase.ts b/src/modules/email-builder/use-cases/SaveTemplateUseCase.ts
new file mode 100644
index 0000000..44a9458
--- /dev/null
+++ b/src/modules/email-builder/use-cases/SaveTemplateUseCase.ts
@@ -0,0 +1,51 @@
+import type { ITemplateRepository } from '../domain/ports/ITemplateRepository';
+import type { TemplateDesign, TemplateSummary } from '../domain/entities/Template';
+import { TemplateValidationError } from '../domain/errors';
+
+const MAX_NAME_LENGTH = 200;
+/** Tope de caracteres para HTML y JSON (Netlify limita el cuerpo a ~6 MB). */
+const MAX_CONTENT_LENGTH = 4_000_000;
+
+export interface SaveTemplateInput {
+  name: unknown;
+  design: unknown;
+  html: unknown;
+}
+
+const isPlainObject = (value: unknown): value is Record<string, unknown> =>
+  typeof value === 'object' && value !== null && !Array.isArray(value);
+
+/** Un diseño exportado por Unlayer siempre trae un objeto `body`. */
+const isDesign = (value: unknown): value is TemplateDesign =>
+  isPlainObject(value) && isPlainObject(value.body);
+
+export class SaveTemplateUseCase {
+  constructor(private readonly repository: ITemplateRepository) {}
+
+  async execute(input: SaveTemplateInput): Promise<TemplateSummary> {
+    const name = typeof input.name === 'string' ? input.name.trim() : '';
+    if (!name) {
+      throw new TemplateValidationError('El nombre de la plantilla es obligatorio');
+    }
+    if (name.length > MAX_NAME_LENGTH) {
+      throw new TemplateValidationError(`El nombre no puede superar ${MAX_NAME_LENGTH} caracteres`);
+    }
+
+    if (!isDesign(input.design)) {
+      throw new TemplateValidationError('El JSON no tiene el formato de un diseño del editor');
+    }
+
+    if (typeof input.html !== 'string' || !input.html.trim()) {
+      throw new TemplateValidationError('El HTML de la plantilla está vacío');
+    }
+
+    if (
+      input.html.length > MAX_CONTENT_LENGTH ||
+      JSON.stringify(input.design).length > MAX_CONTENT_LENGTH
+    ) {
+      throw new TemplateValidationError('La plantilla es demasiado grande para guardarla');
+    }
+
+    return this.repository.save({ name, design: input.design, html: input.html });
+  }
+}
